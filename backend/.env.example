# === DATABASE (PostgreSQL + PostGIS) ===
# Ensure your DB has extensions: CREATE EXTENSION postgis; CREATE EXTENSION pg_trgm;
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/19labs"

# === SECURITY ===
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY="change_this_to_a_secure_random_string_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === GOOGLE INTEGRATION ===
# Used for Smart Onboarding (Places API) and Maps
GOOGLE_MAPS_API_KEY="your_google_maps_key_here"

# === AWS / STORAGE (S3) ===
# Used for storing Reports, Logos, and Signatures
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="19labs-production-assets"

# === NOTIFICATIONS (WhatsApp/SMS) ===
# (Mock or Integrated Service)
WHATSAPP_API_KEY=""
